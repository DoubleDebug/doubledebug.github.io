---
type Props = {
  id: string;
  number: string;
  title: string;
  subtitle: string;
  delay?: string;
};

const { id, number, title, subtitle, delay = 'd3' } = Astro.props;
---

<section id={id} class:list={['fi', delay]}>
  <div class="sec-head">
    <span class="sec-label">{number}</span>
    <h2 class="sec-title">{title}</h2>
  </div>
  <p class="sec-sub">{subtitle}</p>
  <slot />
</section>

<style>
  section {
    margin-bottom: 56px;
  }

  .sec-head {
    margin-bottom: 20px;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .sec-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .sec-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.3px;
    margin: 0;
    display: inline;
  }

  .sec-sub {
    font-size: 13.5px;
    color: var(--text-dim);
    margin-top: -12px;
    margin-bottom: 20px;
    line-height: 1.6;
  }
</style>
